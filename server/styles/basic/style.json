{
  "version": 8,
  "name": "India Full Detail Light",
  "center": [78, 22],
  "zoom": 4,

  "glyphs": "http://localhost:8080/fonts/{fontstack}/{range}.pbf",

  "sources": {
    "india": {
      "type": "vector",
      "url": "mbtiles://india"
    }
  },

  "layers": [



    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#f4f1ec" }
    },



    {
      "id": "landcover",
      "type": "fill",
      "source": "india",
      "source-layer": "landcover",
      "paint": {
        "fill-color": [
          "match", ["get", "class"],
          "wood", "#8bcf9c",
          "grass", "#cdebb0",
          "scrub", "#cfe3b4",
          "sand", "#e8ddc6",
          "glacier", "#e0f3ff",
          "#dddddd"
        ],
        "fill-opacity": 0.9
      }
    },

    {
      "id": "landuse",
      "type": "fill",
      "source": "india",
      "source-layer": "landuse",
      "paint": {
        "fill-color": [
          "match", ["get", "class"],
          "residential", "#e6e2df",
          "commercial", "#dfdbd8",
          "industrial", "#d6d1cd",
          "forest", "#8bcf9c",
          "farmland", "#cdebb0",
          "cemetery", "#d6e6c3",
          "school", "#f2e6c9",
          "hospital", "#f4d6d6",
          "#e0e0e0"
        ]
      }
    },

    {
      "id": "park",
      "type": "fill",
      "source": "india",
      "source-layer": "park",
      "paint": {
        "fill-color": "#b9e3a1",
        "fill-opacity": 0.9
      }
    },



    {
      "id": "water",
      "type": "fill",
      "source": "india",
      "source-layer": "water",
      "paint": { "fill-color": "#9ecae1" }
    },

    {
      "id": "waterway",
      "type": "line",
      "source": "india",
      "source-layer": "waterway",
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#6baed6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.6, 14, 3.5]
      }
    },

    {
      "id": "water-labels",
      "type": "symbol",
      "source": "india",
      "source-layer": "water_name",
      "minzoom": 12,
      "layout": {
        "text-field": ["get", "name:latin"],
        "text-font": ["Noto Sans Italic"],
        "text-size": 12
      },
      "paint": {
        "text-color": "#4a90e2",
        "text-halo-color": "#f4f1ec",
        "text-halo-width": 1
      }
    },

   

    {
      "id": "boundary-country",
      "type": "line",
      "source": "india",
      "source-layer": "boundary",
      "filter": ["==", ["get", "admin_level"], 2],
      "paint": { "line-color": "#9c9483", "line-width": 2 }
    },

    {
      "id": "boundary-state",
      "type": "line",
      "source": "india",
      "source-layer": "boundary",
      "filter": ["==", ["get", "admin_level"], 4],
      "paint": {
        "line-color": "#bfb6a2",
        "line-width": 1,
        "line-dasharray": [4, 2]
      }
    },


    {
      "id": "roads-casing",
      "type": "line",
      "source": "india",
      "source-layer": "transportation",
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#bdbdbd",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1.5, 14, 8]
      }
    },

    {
      "id": "roads",
      "type": "line",
      "source": "india",
      "source-layer": "transportation",
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": [
          "match", ["get", "class"],
          "motorway", "#f05a28",
          "trunk", "#f37b4a",
          "primary", "#f4a259",
          "secondary", "#ffd166",
          "tertiary", "#ffffff",
          "service", "#dddddd",
          "#ffffff"
        ],
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.8, 14, 6]
      }
    },

    {
      "id": "railway",
      "type": "line",
      "source": "india",
      "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "rail"],
      "paint": {
        "line-color": "#666666",
        "line-dasharray": [2, 2],
        "line-width": 1.5
      }
    },



    {
      "id": "buildings",
      "type": "fill",
      "source": "india",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#e0d5c8",
        "fill-opacity": 0.85
      }
    },

    {
      "id": "building-labels",
      "type": "symbol",
      "source": "india",
      "source-layer": "building",
      "minzoom": 15,
      "layout": {
        "text-field": ["get", "name:latin"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12
      }
    },

{
  "id": "road-labels",
  "type": "symbol",
  "source": "india",
  "source-layer": "transportation_name",
  "minzoom": 12,
  "layout": {
    "text-field": [
      "coalesce",
      ["get", "name:latin"],
      ["get", "name:en"],
      ["get", "name"]
    ],
    "text-font": ["Noto Sans Regular"],
    "text-size": [
      "interpolate", ["linear"], ["zoom"],
      12, 10,
      16, 14
    ],
    "symbol-placement": "line",
    "text-rotation-alignment": "map"
  },
  "paint": {
    "text-color": "#555555",
    "text-halo-color": "#f4f1ec",
    "text-halo-width": 1.2
  }
}
,
{
  "id": "buildings-3d",
  "type": "fill-extrusion",
  "source": "india",
  "source-layer": "building",
  "minzoom": 15,
  "paint": {
    "fill-extrusion-color": ["coalesce", ["get", "colour"], "#d6cfc7"],
    "fill-extrusion-height": ["get", "render_height"],
    "fill-extrusion-base": ["get", "render_min_height"],
    "fill-extrusion-opacity": 0.9
  }
}
,{
  "id": "house-numbers",
  "type": "symbol",
  "source": "india",
  "source-layer": "housenumber",
  "minzoom": 17,
  "layout": {
    "text-field": ["get", "housenumber"],
    "text-font": ["Noto Sans Regular"],
    "text-size": 10
  },
  "paint": {
    "text-color": "#444",
    "text-halo-color": "#ffffff",
    "text-halo-width": 1
  }
}

,

    {
      "id": "poi",
      "type": "symbol",
      "source": "india",
      "source-layer": "poi",
      "minzoom": 14,
      "layout": {
        "text-field": ["get", "name:latin"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11
      },
      "paint": {
        "text-color": "#444444",
        "text-halo-color": "#f4f1ec",
        "text-halo-width": 1
      }
    },



    {
      "id": "place-labels",
      "type": "symbol",
      "source": "india",
      "source-layer": "place",
      "layout": {
        "text-field": ["get", "name:latin"],
        "text-font": ["Noto Sans Regular"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          4, 10,
          8, 14,
          14, 20
        ]
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "#f4f1ec",
        "text-halo-width": 2
      }
    },

    {
      "id": "mountain-peaks",
      "type": "symbol",
      "source": "india",
      "source-layer": "mountain_peak",
      "minzoom": 11,
      "layout": {
        "text-field": ["get", "name:latin"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12
      }
    }
  ]
}
